{
  "manifest_version": 3,
  "name": "Jarvis Bridge",
  "version": "1.0.0",
  "description": "Lets your local Jarvis assistant open, read and act in tabs of this Chrome (with your accounts). Connects only to 127.0.0.1.",
  "permissions": ["debugger", "tabs", "alarms"],
  "background": { "service_worker": "background.js" },
  "key": ""
}
