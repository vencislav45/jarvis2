# Copy to .env and fill in. .env is read at startup; real environment variables win.
# Existing installs: `python -m core.settings --migrate` moves the key out of config/api_keys.json.

# Required
GEMINI_API_KEY=

# Models / voice
JARVIS_LIVE_MODEL=models/gemini-2.5-flash-native-audio-preview-12-2025
JARVIS_VOICE=Charon

# 1 = keep the microphone open while the assistant speaks so you can say "stop".
# Use only with a headset; with speakers the assistant would hear itself.
JARVIS_BARGE_IN=0

# my_chrome (default): open sites, read pages, click and send messages in YOUR Google Chrome with
#   your accounts. Opening sites works right away; reading/clicking/messaging needs the Jarvis
#   Bridge extension installed once (chrome://extensions → Developer mode → Load unpacked →
#   the chrome_extension folder).
# separate: use a standalone automation window with its own profile instead (sign in there once).
JARVIS_BROWSER_MODE=my_chrome
# Port the extension connects to (also change PORT in chrome_extension/background.js).
JARVIS_BRIDGE_PORT=48761

# Only for JARVIS_BROWSER_MODE=separate:
# Browser for the standalone window. Empty = Chrome if installed. chrome | edge | brave | firefox
JARVIS_AUTOMATION_BROWSER=
# Its profile folder. Default: %USERPROFILE%\.jarvis_profiles
JARVIS_BROWSER_PROFILE_DIR=
# How long to wait for you to sign in when a service is signed out.
JARVIS_LOGIN_WAIT_SECONDS=120

# World news also includes this many headlines from your country (0 = only world news).
JARVIS_NEWS_COUNTRY=Bulgaria
JARVIS_NEWS_LOCAL_COUNT=3

# Viber/Telegram/Signal/Discord desktop apps can't confirm the recipient, so messages
# are typed as a draft for you to send. Set to "send" to press Enter automatically.
JARVIS_DESKTOP_MESSAGING=draft

# Paths for apps that are not on PATH: JARVIS_APP_<NAME>=full path
# JARVIS_APP_DAVINCI_RESOLVE=C:\Program Files\Blackmagic Design\DaVinci Resolve\Resolve.exe
